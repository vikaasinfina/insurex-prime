# ─── InsuroX Prime backend ────────────────────────────────────────────────────
# Copy to .env for local development. Never commit real values.
# None of these may be exposed to the frontend or prefixed with VITE_.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/insurex

# Firebase project used by the frontend's Google sign-in (same project ID).
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional service account (Firebase Console > Project settings > Service accounts).
# ID-token verification works with FIREBASE_PROJECT_ID alone; with a service account,
# revoked tokens are also rejected. Set both or neither. The private key may use
# literal \n sequences; it is normalized at startup. Never commit the JSON file.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Comma-separated browser origins allowed by CORS (no trailing slash). "*" is
# rejected when NODE_ENV=production.
FRONTEND_URL=http://localhost:8080,https://insurex-prime.vercel.app

# Comma-separated Google account emails provisioned as SUPER_ADMIN on first sign-in.
SUPER_ADMIN_EMAILS=

# Super Admin password sign-in: any of these IDs (email and/or phone) + the password.
# The first ID containing "@" becomes the Super Admin account's email.
ADMIN_LOGIN_IDS=
ADMIN_PASSWORD=

# true only behind a trusted reverse proxy (so client IPs in audit logs are correct).
TRUST_PROXY=false
# Serve Swagger UI at /docs.
DOCS_ENABLED=true

# Agent password sign-in uses an HttpOnly session cookie (sessions are stored hashed in
# PostgreSQL and revoked on logout, password change and suspension).
AGENT_SESSION_TTL_HOURS=720
# "lax" when the frontend and API share a site (localhost, or app.example.com +
# api.example.com). "none" only for different sites; it requires AGENT_COOKIE_SECURE=true
# and is subject to browsers' third-party-cookie blocking.
AGENT_COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production.
AGENT_COOKIE_SECURE=
# Optional, e.g. ".example.com" to share the cookie between subdomains.
AGENT_COOKIE_DOMAIN=

# ─── Forgot password (emails a reset link + temporary password) ───────────────
# Resend HTTPS API; both RESEND_* values and PASSWORD_RESET_SECRET are needed or the
# feature reports itself unavailable. The link points at the first FRONTEND_URL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=InsuroX Prime
# 32+ random characters used to sign reset links (e.g. `openssl rand -hex 32`).
PASSWORD_RESET_SECRET=
PASSWORD_RESET_TTL_MINUTES=30
