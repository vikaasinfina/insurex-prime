// InsuroX Prime — PostgreSQL schema.
// Money is stored as DECIMAL; dates without a time component use DATE.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  /// Platform operator: manages tenants and insurers; has no tenant of their own.
  SUPER_ADMIN
  /// The single admin of one tenant (an agency attached to one insurer).
  TENANT_ADMIN
  AGENT
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// The line of business a catalog policy belongs to.
enum InsuranceType {
  HEALTH
  MOTOR
  LIFE
  COMMERCIAL
}

enum PolicyStatus {
  ACTIVE
  INACTIVE
}

enum PremiumFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum PaymentStatus {
  PENDING
  DUE
  PAID
  FAILED
  REFUNDED
}

enum SoldPolicyStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum GoalCadence {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum FieldNoteStatus {
  IN_PROGRESS
  COMPLETED
  POSTPONED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  NET_BANKING
  BANK_TRANSFER
  CHEQUE
}

/// An insurance company (TATA AIG, TATA AIA, LIC, HDFC…). Platform-managed master data.
model Insurer {
  id        String   @id @default(uuid()) @db.Uuid
  /// Stable machine code, e.g. TATA_AIA. Also selects the built-in catalog template.
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantLinks TenantInsurer[]
  categories  PolicyCategory[]
  policies    Policy[]

  @@map("insurers")
}

/// An agency (e.g. Aakruthi Enterprises). Everything it owns (agents, customers, catalog,
/// sales, receipts, audit trail) is isolated by `tenantId`. An agency can sell for several
/// insurers; each relationship (with its business and licence codes) is a TenantInsurer.
model Tenant {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  legalName    String
  /// Agency logo as a small `data:image/...;base64` URL, shown to its admin and agents.
  logoUrl      String?      @db.Text
  contactEmail String?
  contactPhone String?
  /// Agency postal address, edited by the tenant admin.
  address      String?      @db.Text
  status       TenantStatus @default(ACTIVE)
  activatedAt  DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  insurers   TenantInsurer[]
  users      User[]
  agents     Agent[]
  customers  Customer[]
  categories PolicyCategory[]
  policies   Policy[]
  sold       SoldPolicy[]
  receipts   Receipt[]
  salesGoals SalesGoal[]
  fieldNotes FieldNote[]
  meetings   Meeting[]
  auditLogs  AuditLog[]

  @@index([status])
  @@map("tenants")
}

/// The agency's licence with one insurer: the business and policy-selling licence codes the
/// insurer issued to it.
model TenantInsurer {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  insurerId    String   @db.Uuid
  businessCode String
  licenceCode  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  insurer Insurer @relation(fields: [insurerId], references: [id], onDelete: Restrict)

  @@unique([tenantId, insurerId])
  @@unique([insurerId, businessCode])
  @@index([tenantId])
  @@map("tenant_insurers")
}

/// A node in a tenant's catalog tree below a line of business, e.g. LIFE → Savings
/// Solutions, or HEALTH → Indemnity. Categories can nest through `parentId`.
model PolicyCategory {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  insurerId String        @db.Uuid
  line      InsuranceType
  parentId  String?       @db.Uuid
  name      String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  insurer  Insurer          @relation(fields: [insurerId], references: [id], onDelete: Restrict)
  parent   PolicyCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children PolicyCategory[] @relation("CategoryTree")
  policies Policy[]

  @@index([tenantId, insurerId, line, parentId])
  @@map("policy_categories")
}

/// A person who can sign in. Identity comes from Firebase; role is decided here.
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  /// Null until the user's first Firebase sign-in links the account.
  firebaseUid        String?    @unique
  /// Stored lowercase. Also the agent's contact email (not duplicated on Agent).
  email              String     @unique
  role               Role
  status             UserStatus @default(ACTIVE)
  /// scrypt hash for agent password sign-in. Null until a password is issued.
  passwordHash       String?
  /// Set when a temporary password is issued; cleared once the user picks their own.
  mustChangePassword Boolean    @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  /// Null for platform SUPER_ADMINs; set for TENANT_ADMIN and AGENT.
  tenantId           String?    @db.Uuid
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agent             Agent?
  auditLogs         AuditLog[]
  agentSessions     AgentSession[]
  updatedSettings   SystemSetting[]
  organizedMeetings Meeting[]          @relation("MeetingOrganizer")
  meetingInvites    MeetingAttendee[]
  fieldNotes        FieldNote[]
  pushSubscriptions PushSubscription[]

  @@index([role])
  @@index([tenantId, role])
  @@map("users")
}

model Agent {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  userId    String      @unique @db.Uuid
  agentCode String      @unique
  fullName  String
  phone     String
  address   String?
  joinedAt  DateTime    @default(now()) @db.Date
  status    AgentStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  customers    Customer[]
  soldPolicies SoldPolicy[]
  salesGoals   SalesGoal[]
  fieldNotes   FieldNote[]

  @@index([tenantId, status])
  @@index([status])
  @@index([fullName])
  @@map("agents")
}

model Customer {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @db.Uuid
  customerCode        String         @unique
  fullName            String
  dateOfBirth         DateTime?      @db.Date
  gender              Gender?
  phone               String
  email               String?
  address             String?
  city                String?
  state               String?
  nomineeName         String?
  nomineeRelationship String?
  assignedAgentId     String?        @db.Uuid
  status              CustomerStatus @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignedAgent Agent?       @relation(fields: [assignedAgentId], references: [id], onDelete: Restrict)
  soldPolicies  SoldPolicy[]

  @@index([tenantId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([fullName])
  @@index([createdAt])
  @@map("customers")
}

/// A product in the catalog. Only ACTIVE policies can be sold by agents.
model Policy {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  /// The insurer whose product this is (a tenant can sell for several).
  insurerId        String           @db.Uuid
  /// Optional position in the tenant's catalog tree (below the line of business).
  categoryId       String?          @db.Uuid
  policyCode       String
  policyName       String
  insuranceType    InsuranceType
  description      String           @default("")
  /// Catalog price/cover/term are optional: many insurer products are quoted on the
  /// insurer's own portal, so the sale records the real figures.
  coverageAmount   Decimal?         @db.Decimal(14, 2)
  premium          Decimal?         @db.Decimal(12, 2)
  premiumFrequency PremiumFrequency @default(ANNUAL)
  durationMonths   Int?
  eligibility      String           @default("")
  benefits         String[]
  terms            String           @default("")
  /// Health- or motor-specific fields, validated by the API per insuranceType.
  categoryDetails  Json?
  status           PolicyStatus     @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  insurer      Insurer         @relation(fields: [insurerId], references: [id], onDelete: Restrict)
  category     PolicyCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  soldPolicies SoldPolicy[]

  @@unique([tenantId, policyCode])
  @@index([tenantId, insurerId, insuranceType, status])
  @@index([categoryId])
  @@index([insuranceType, status])
  @@index([status])
  @@index([policyName])
  @@map("policies")
}

model SoldPolicy {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @db.Uuid
  policyNumber        String           @unique
  /// The policy number issued by the insurer's own portal, when known.
  insurerPolicyNumber String?
  policyId            String           @db.Uuid
  customerId          String           @db.Uuid
  agentId             String           @db.Uuid
  /// Premium agreed at sale time; catalog prices can change later.
  premium             Decimal          @db.Decimal(12, 2)
  issueDate           DateTime         @db.Date
  /// First time this policy was ever issued (before renewals). Null means a new policy: age counts from issueDate.
  inceptionDate       DateTime?        @db.Date
  expiryDate          DateTime         @db.Date
  /// LIFE only: years premiums must be paid (e.g. 15). Null = no fixed paying term.
  premiumPayingTerm   Int?
  /// True when this sale's period is the last premium year (inception + term). Once it
  /// ends the policy is COMPLETED and is never offered for renewal.
  isFinalPremium      Boolean          @default(false)
  paymentStatus       PaymentStatus    @default(PENDING)
  policyStatus        SoldPolicyStatus @default(PENDING)
  /// The earlier sale this one renews. That sale stops counting as expired. Cleared if this sale is deleted.
  renewedFromId       String?          @db.Uuid
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  policy      Policy       @relation(fields: [policyId], references: [id], onDelete: Restrict)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  agent       Agent        @relation(fields: [agentId], references: [id], onDelete: Restrict)
  receipts    Receipt[]
  renewedFrom SoldPolicy?  @relation("Renewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals    SoldPolicy[] @relation("Renewal")

  @@index([tenantId, issueDate])
  @@index([agentId, issueDate])
  @@index([agentId, expiryDate])
  @@index([customerId])
  @@index([policyId])
  @@index([issueDate])
  @@index([policyStatus])
  @@index([paymentStatus])
  @@index([renewedFromId])
  @@map("sold_policies")
}

model Receipt {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  receiptNumber String        @unique
  soldPolicyId  String        @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PAID)
  issuedAt      DateTime      @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  soldPolicy SoldPolicy @relation(fields: [soldPolicyId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([soldPolicyId])
  @@index([issuedAt])
  @@map("receipts")
}

/// A signed-in agent browser session. Only a SHA-256 hash of the cookie token is stored.
/// An agent's recurring target for one line of business. The period is always the current
/// week/month/quarter/year; progress is computed from the agent's sold policies. No row
/// (or zero targets) means no goal is set. COMMERCIAL sales are not tracked by goals.
model SalesGoal {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  agentId        String        @db.Uuid
  cadence        GoalCadence
  category       InsuranceType
  targetPolicies Int
  targetPremium  Decimal       @default(0) @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, cadence, category])
  @@index([tenantId])
  @@map("sales_goals")
}

/// A "sticky memo" an agent logs between customer visits, with an optional follow-up.
model FieldNote {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  /// Whoever logged it: an agent or an admin. Notes are private to this user.
  userId         String          @db.Uuid
  /// Set when the owner is an agent.
  agentId        String?         @db.Uuid
  clientName     String
  contactName    String          @default("")
  phone          String          @default("")
  coverage       String          @default("")
  category       InsuranceType
  note           String
  /// Short label under the memo, e.g. "Sticky Note #104".
  tag            String          @default("")
  status         FieldNoteStatus @default(IN_PROGRESS)
  followUpAt     DateTime?
  followUpLabel  String          @default("")
  /// Set for recurring follow-ups, e.g. "Annual".
  recurring      String?
  /// Set once the "1 hour to go" reminder email has been sent (cleared when the follow-up moves).
  reminderSentAt DateTime?
  loggedAt       DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent  Agent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@index([userId, status])
  @@index([userId, followUpAt])
  @@index([agentId, loggedAt])
  @@index([agentId, status])
  @@index([agentId, followUpAt])
  @@index([followUpAt, reminderSentAt])
  @@index([tenantId])
  @@map("field_notes")
}

/// A scheduled meeting. An admin invites agents; an agent invites the agency's admins.
/// Only the organizer can change or cancel it.
model Meeting {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  organizerId        String    @db.Uuid
  title              String
  description        String    @default("")
  /// Google Meet / Zoom (or any https) join link.
  meetingUrl         String    @default("")
  /// Outside guests (any email) invited alongside the agents/admins.
  guestEmails        String[]  @default([])
  startsAt           DateTime
  endsAt             DateTime
  /// Set once the "starts in 2 hours" / "starts in 15 minutes" phone alerts went out.
  pushedTwoHoursAt   DateTime?
  pushedFifteenMinAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organizer User              @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  attendees MeetingAttendee[]

  @@index([tenantId, startsAt])
  @@index([organizerId, startsAt])
  @@index([startsAt])
  @@map("meetings")
}

model MeetingAttendee {
  meetingId String @db.Uuid
  userId    String @db.Uuid

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
  @@map("meeting_attendees")
}

/// One installed app / browser that agreed to receive phone alerts (Web Push).
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model AgentSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("agent_sessions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  /// Null for platform-level actions (tenant activation, insurers).
  tenantId  String?  @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  /// Non-sensitive context only (codes, changed field names). Never tokens or secrets.
  metadata  Json?
  ipAddress String?
  requestId String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Non-secret, runtime-editable platform configuration (one row per key). Secrets and
/// deployment settings stay in environment variables. Missing rows fall back to the
/// defaults in `modules/settings/settings.schemas.ts`.
model SystemSetting {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  category        String
  value           Json
  description     String?
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([category])
  @@map("system_settings")
}
